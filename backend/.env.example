# Replace YOUR_POSTGRES_USER with your local PostgreSQL username.
DATABASE_URL=postgresql+psycopg://YOUR_POSTGRES_USER@localhost/wakecast

# Tests must use the separate wakecast_test database.
TEST_DATABASE_URL=postgresql+psycopg://YOUR_POSTGRES_USER@localhost/wakecast_test

# Leave empty to disable manual weather refresh.
# Set a randomly generated secret in your actual .env file to enable it.
WEATHER_REFRESH_API_KEY=